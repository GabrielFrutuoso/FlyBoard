{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlyBoard",
  "version": "0.1.8",
  "identifier": "com.bf14a.flyboard",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FlyBoard",
        "width": 420,
        "height": 150,
        "minWidth": 420,
        "minHeight": 150,
        "maxWidth": 630,
        "maxHeight": 225,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/60-flyboard-uinput.rules"],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/60-flyboard-uinput.rules": "resources/60-flyboard-uinput.rules"
        },
        "postInstallScript": "resources/postinst"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
